# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to update stock and read tickets for magic links, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for ticket and demo-request emails
RESEND_API_KEY=

# Public URL of the deployment, used to build the links inside emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000
